prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libramdiskpatcher
Description: A library for patching iOS ramdisks

Requires: @libgeneral_requires@ @libpatchfinder_requires@ @libramdisk_requires@ @openssl_requires@
Version: @VERSION_COMMIT_COUNT@
Libs: -L${libdir} -lramdiskpatcher
Cflags: -I${includedir}
